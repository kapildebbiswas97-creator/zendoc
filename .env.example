ZENDOC_ENV=production
ZENDOC_SECRET_KEY=replace-with-a-long-random-secret
ZENDOC_ADMIN_EMAIL=replace-with-admin-email
ZENDOC_ADMIN_PASSWORD=replace-with-strong-admin-password
ZENDOC_MAX_UPLOAD_BYTES=10485760
ZENDOC_RATE_LIMIT_PER_MINUTE=120
ZENDOC_AUTH_RATE_LIMIT_PER_MINUTE=20
ZENDOC_API_ACCESS_TOKEN_MINUTES=60
ZENDOC_API_REFRESH_TOKEN_DAYS=30
ZENDOC_SESSION_LIFETIME_HOURS=12
ZENDOC_SESSION_IDLE_MINUTES=120
ZENDOC_AI_PROVIDER=
ZENDOC_AI_API_KEY=
ZENDOC_AI_BASE_URL=
ZENDOC_AI_MODEL=
