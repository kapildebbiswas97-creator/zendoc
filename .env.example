# =============================================================================
# ZENDOC 2.0 â€” Environment Variables Template
# Architecture: Next.js 15+ App Router on Vercel + Supabase
# =============================================================================

# Canonical Application URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Obtain from: Supabase Dashboard â†’ Project Settings â†’ API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...replace-with-anon-public-key

# PRIVILEGED BACKEND KEY (SERVER-ONLY â€” NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-with-service-role-key

# Database Connection String (Direct or Session Pooler for Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# AI Advisory & Model Routing (Optional)
# -----------------------------------------------------------------------------
# Supported: anthropic, openai, gemini, mock
ZENDOC_AI_PROVIDER=mock
ZENDOC_AI_API_KEY=
ZENDOC_AI_MODEL=claude-3-5-sonnet-20241022
ZENDOC_AI_TIMEOUT=20

# -----------------------------------------------------------------------------
# Optional Specialized Python Worker Boundary
# Retained strictly for heavy ML / Whisper ASR / Complex PDF OCR workloads
# -----------------------------------------------------------------------------
PYTHON_WORKER_ENABLED=false
PYTHON_WORKER_URL=http://127.0.0.1:8000
PYTHON_WORKER_SECRET=replace-with-internal-worker-secret
