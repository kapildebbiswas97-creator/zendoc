ZENDOC_EDGECARE_ASR_BASE_URL=http://127.0.0.1:8001
ZENDOC_EDGECARE_ASR_TIMEOUT=30
ZENDOC_EDGECARE_ASR_MAX_AUDIO_BYTES=8388608
ZENDOC_EDGECARE_ASR_ALLOW_PRIVATE_NETWORK=false
DATABASE_URL=
ZENDOC_DATABASE_PATH=
ZENDOC_PERSISTENCE_MODE=
ZENDOC_PERSISTENCE_VERIFIED=false
ZENDOC_REQUIRE_DURABLE_DATABASE=false
ZENDOC_BACKUP_VERIFIED=false
