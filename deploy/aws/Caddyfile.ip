{
  email {$ZENDOC_TLS_EMAIL}
  # IP-address HTTPS clients may omit SNI; select the certificate for this origin.
  default_sni {$ZENDOC_DOMAIN}
}

{$ZENDOC_DOMAIN} {
  tls {
    issuer acme {
      profile shortlived
    }
  }

  encode zstd gzip

  @public_health path /api/v1/health /api/v1/ready
  handle @public_health {
    reverse_proxy web:8000 {
      header_up -X-Zendoc-Gateway-Token
      header_up -X-Zendoc-Gateway-Verified
      header_up -X-Vercel-Forwarded-For
    }
  }

  @vercel_gateway header X-Zendoc-Gateway-Token {$ZENDOC_GATEWAY_TOKEN}
  handle @vercel_gateway {
    reverse_proxy web:8000 {
      header_up -X-Zendoc-Gateway-Token
      header_up -X-Zendoc-Gateway-Verified
      header_up X-Zendoc-Gateway-Verified "1"
    }
  }

  handle {
    respond "Forbidden" 403
  }

  header {
    -Server
  }
}
