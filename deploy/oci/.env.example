# Copy this file to deploy/oci/.env and chmod 600 it.
# Never commit the real .env.

# Public hostname from your free/student domain.
ZENDOC_DOMAIN=zendoc.example
ZENDOC_TLS_EMAIL=owner@example.com

# Record the exact reviewed Git commit at deployment time.
ZENDOC_GIT_COMMIT=replace-with-reviewed-40-character-commit

# Generate long random hexadecimal values so URL interpolation remains safe:
#   openssl rand -hex 32
POSTGRES_DB=zendoc
POSTGRES_USER=zendoc
POSTGRES_PASSWORD=replace-with-random-hex-password
ZENDOC_SECRET_KEY=replace-with-separate-random-secret
ZENDOC_ADMIN_EMAIL=owner@example.com
ZENDOC_ADMIN_PASSWORD=replace-with-strong-unique-password

# Keep these false until the corresponding operator verification is actually
# completed. Do not flip them simply to satisfy startup checks.
ZENDOC_PERSISTENCE_VERIFIED=false
ZENDOC_BACKUP_VERIFIED=false
ZENDOC_PUBLIC_RELEASE_REQUIRED=false

# Truthful defaults for integrations that are not configured yet.
ZENDOC_CONNECTED_CARE_DATA_MODE=LIVE
ZENDOC_PLACES_PROVIDER=none
ZENDOC_VIDEO_PROVIDER=none
ZENDOC_LOCAL_AI_ENABLED=false
ZENDOC_MODEL_EVALUATION_REAL_ENABLED=false
ZENDOC_EMAIL_PROVIDER=none
ZENDOC_EMAIL_VERIFIED=false
ZENDOC_STORAGE_PROVIDER=local
ZENDOC_STORAGE_VERIFIED=false

# Configure these only when real provider credentials/infrastructure exist.
ZENDOC_SUPPORT_EMAIL=
ZENDOC_SMTP_HOST=
ZENDOC_SMTP_PORT=587
ZENDOC_SMTP_USERNAME=
ZENDOC_SMTP_PASSWORD=
ZENDOC_SMTP_FROM_EMAIL=
ZENDOC_SMTP_USE_TLS=true
ZENDOC_SMTP_USE_SSL=false

# Existing S3-compatible storage integration can be used with a real durable
# object-store account. Leave blank until configured and verified.
# OCI Object Storage S3 compatibility example:
# ZENDOC_S3_ENDPOINT_URL=https://NAMESPACE.compat.objectstorage.REGION.oci.customer-oci.com
# ZENDOC_S3_REGION=REGION
# Create a dedicated bucket + least-privilege Customer Secret Key first.
ZENDOC_S3_ENDPOINT_URL=
ZENDOC_S3_REGION=
ZENDOC_S3_BUCKET=
ZENDOC_S3_ACCESS_KEY_ID=
ZENDOC_S3_SECRET_ACCESS_KEY=
# OCI Object Storage encrypts objects at rest by default. Leave this blank for
# the OCI S3-compatibility path unless a separately tested header mode is used.
ZENDOC_S3_SERVER_SIDE_ENCRYPTION=
