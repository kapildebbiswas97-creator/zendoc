# Never include source-control internals, local secret files or patient data
# in the Flask/worker/backup Docker build contexts.
.git
.gitignore
.github
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/uploads
**/backups
**/backup
**/node_modules
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/htmlcov
**/.codex
**/.kiro
**/.aws
**/.ssh
**/*.log
**/tmp
**/temp
